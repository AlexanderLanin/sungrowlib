{
  "name": "sungrowlib",
  "version": "0.1.0",
  "description": "TypeScript library for Sungrow inverter communication over Modbus TCP and HTTP/WebSocket (WiNet-S)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "bin": {
    "sungrowlib": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:conformance": "npm run build && python3 conformance/runner/run.py --scenarios conformance/scenarios/ --cli 'node dist/cli/main.js'",
    "check": "tsc --noEmit",
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sungrow",
    "inverter",
    "solar",
    "modbus",
    "winet",
    "photovoltaic",
    "pv",
    "energy",
    "smart-home",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexanderLanin/sungrowlib.git"
  },
  "dependencies": {
    "modbus-serial": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
